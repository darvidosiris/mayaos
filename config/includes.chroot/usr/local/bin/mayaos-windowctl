#!/usr/bin/env python3
"""Minimal EWMH/X11 window listing and activation for the MayaOS preview dock."""
import subprocess
import sys

def xprop(*args):
    try:
        return subprocess.check_output(["xprop", *args], text=True, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""

def ids():
    line = xprop("-root", "_NET_CLIENT_LIST")
    if "#" not in line:
        return []
    return [s.strip() for s in line.split("#", 1)[1].split(",") if s.strip().startswith("0x")]

def title(wid):
    data = xprop("-id", wid, "_NET_WM_NAME", "WM_NAME")
    for line in data.splitlines():
        if "=" in line and "not found" not in line:
            return line.split("=", 1)[1].strip().strip('"')
    return ""

def skip(wid):
    data = xprop("-id", wid, "_NET_WM_WINDOW_TYPE", "_NET_WM_STATE")
    return any(token in data for token in ("_NET_WM_WINDOW_TYPE_DOCK", "_NET_WM_WINDOW_TYPE_DESKTOP", "_NET_WM_STATE_SKIP_TASKBAR"))

if len(sys.argv) > 1 and sys.argv[1] == "list":
    for wid in ids():
        if not skip(wid):
            name = title(wid).replace("\t", " ").replace("\n", " ").strip()
            if name and "MayaOS" not in name:
                print(f"{wid}\t{name[:70]}")
elif len(sys.argv) == 3 and sys.argv[1] in ("activate", "minimize"):
    wid = sys.argv[2]
    if wid in ids() and not skip(wid):
        if sys.argv[1] == "activate":
            subprocess.run(["wmctrl", "-ia", wid], check=False)
        else:
            subprocess.run(["xdotool", "windowminimize", str(int(wid, 16))], check=False)
else:
    print("Usage: mayaos-windowctl list | activate WINDOW_ID | minimize WINDOW_ID", file=sys.stderr)
    sys.exit(2)
